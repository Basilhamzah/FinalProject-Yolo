<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Results</title>
  <link rel="stylesheet" href="/style.css" />
  <style>
    :root{
      --sidebar-w:220px;
      --card-bg:#1f2430;
      --card-muted:#2a3040;
      --text:#e7e9ee;
      --text-dim:#aab2c5;
      --accent:#7dd3fc;
      --danger:#f87171;
      --ok:#34d399;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, Noto Sans, "Apple Color Emoji","Segoe UI Emoji";
      background:linear-gradient(135deg,#0f2027,#203a43,#2c5364);
      color:var(--text);
      display:flex;
      min-height:100vh;
    }
    /* Sidebar */
    .sidebar {
      width: 220px;
      background-color: #1f1f2e;
      color: white;
      padding: 20px;
      height: 100vh;
      position: fixed;
      top: 0;
      left: 0;
    }
    .sidebar h2 { font-size: 1.2rem; margin-bottom: 20px; }
    .sidebar ul { list-style-type: none; padding: 0; }
    .sidebar ul li a { display: block; padding: 10px; margin-bottom: 10px; text-decoration: none; color: white; border-radius: 5px; }
    .sidebar ul li a:hover { background-color: #3e3e5e; }
    .nav a{
      display:block; padding:10px 12px; border-radius:10px; text-decoration:none; color:#e5e7eb;
      background:transparent; transition:.2s ease;
    }
    .nav a:hover{background:#1f2937}
    .nav a.active{background:#0ea5e9;color:white}
    .spacer{flex:1}
    /* Main */
    .main { margin-left: 240px; width: 100%; padding: 40px; flex: 1; color: white; }
    .header{display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px;}
    .title{font-size:1.6rem;margin:0}
    /* Controls */
    .controls{display:flex; flex-wrap:wrap; gap:12px; margin:16px 0; justify-content:center; width:100%; max-width:780px; margin-inline:auto;} 
    .controls .btn-ghost, .controls .btn-primary{min-width:140px; text-align:center;}
    .controls input, .controls select, .controls button{
      background:#0b1220; color:var(--text);
      border:1px solid #253045; border-radius:10px; padding:10px 12px; outline:none;
    }
    .controls button{cursor:pointer}
    .btn-primary{background:#0891b2;border-color:#0891b2}
    .btn-ghost{background:transparent}
    /* Cards */
    .cards{display:flex;justify-content:center;align-items:stretch;gap:18px;margin-top:24px}
    .card{background:var(--card-bg);border:1px solid #2d3649;border-radius:16px;padding:16px;box-shadow:0 6px 20px rgba(0,0,0,.25)}
    .card h4{margin:0 0 6px;font-weight:600;color:var(--text-dim)}
    .card .val{font-size:1.8rem;font-weight:700}
    .muted{color:var(--text-dim);font-size:.9rem}
    .rate-badge{display:inline-block;padding:4px 10px;border-radius:999px;background:#0b1220;border:1px solid #2d3649}
    /* Table */
    .table-wrap{margin-top:18px;background:rgba(15,23,42,.45);border:1px solid #2d3649;border-radius:16px;overflow:hidden}
    table{width:100%;border-collapse:collapse}
    thead{background:#0b1220}
    th,td{padding:12px 14px;text-align:left;border-bottom:1px solid #223148}
    th{font-weight:600;color:#cbd5e1}
    tbody tr:hover{background:#0b1220}
    .badge{display:inline-block;padding:4px 8px;border-radius:8px;background:#0b1220;border:1px solid #2d3649;margin:2px}
    .badge.ok{border-color:#14532d}
    .badge.defect{border-color:#4c1d1d}
    .actions{display:flex;gap:8px}
    .actions a{padding:8px 10px;border-radius:10px;border:1px solid #2d3649;text-decoration:none;color:#e5e7eb}
    .actions a:hover{background:#0b1220}
    /* Empty state */
    .empty{padding:24px;text-align:center;color:var(--text-dim)}
    /* Responsive */
    @media (max-width: 980px){.cards{grid-template-columns:1fr}} 
  /* Centered big card */
    .card.card-lg{ width: 420px; max-width: 95%; text-align:center; padding: 24px 28px; }
    .card.card-lg .val{ font-size: 2.4rem; }
    .rate-badge-lg{ padding: 10px 16px; font-size: 1.4rem; }
    .table-wrap{ margin-top: 28px; }
  </style>
</head>
<body>
  <!-- Sidebar -->
  <div class="sidebar">
    <h2>👤 Hello ,<%= (user && user.name) ? user.name : 'User' %></h2>
    <ul>
      <li><a href="/">📤 Upload Video</a></li>
      <li><a href="/user/dashboard">📊 Results Dashboard</a></li>
      <li><a class="active" href="/user/results">✍🏻 User Results</a></li>
      <li><a href="/logout">🚪 Logout</a></li>
    </ul>
  </div>

  <main class="main">
    <div class="header">
      <h1 class="title">Your Results</h1>
      <div class="controls">
        <input id="from" type="date" />
        <input id="to" type="date" />
        <select id="sort">
          <option value="date_desc">Newest</option>
          <option value="date_asc">Oldest</option>
          <option value="defect_desc">Defect rate ↓</option>
          <option value="defect_asc">Defect rate ↑</option>
        </select>
        <button id="clear" class="btn-ghost">Clear</button>
        <button id="export" class="btn-primary">Export CSV</button>
      </div>
    </div>

    <!-- Summary cards -->
    <section class="cards" id="cards">
      <% 
        let _totalVideos = (results || []).length;
        let _sumDefected = 0, _sumTotal = 0;
        (results || []).forEach(r=>{ _sumDefected += (r.defected_count||0); _sumTotal += (r.total_count||0); });
        let _rate = _sumTotal>0 ? (_sumDefected/_sumTotal*100) : 0;
      %>
      <div class="card card-lg">
        <h4>Defective / Total</h4>
        <div class="val"><%= _sumDefected %></div>
        <div class="muted">of <span class="total-out-of"><%= _sumTotal %></span> total • <span class="rate-badge rate-badge-lg"><%= _rate.toFixed(1) %>%</span></div>
      </div>
    </section>

    <!-- Results table -->
    <div class="table-wrap">
      <table id="results-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Video</th>
            <th>Defected</th>
            <th>Total</th>
            <th>Defect rate</th>
            <th>Breakdown</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!results || results.length===0) { %>
            <tr><td colspan="7" class="empty">No results yet.</td></tr>
          <% } else { %>
            <% results.forEach((r)=>{ 
                const d = new Date(r.created_at);
                const rate = (r.total_count>0)? (r.defected_count/r.total_count*100):0;
            %>
              <tr data-created="<%= d.toISOString() %>" data-defect-rate="<%= rate %>" data-name="<%= (r.video_name||'').toLowerCase() %>">
                <td><%= d.toLocaleString('en-GB') %></td>
                <td><%= r.video_name %></td>
                <td style="color:var(--danger);font-weight:600"><%= r.defected_count %></td>
                <td><%= r.total_count %></td>
                <td><%= rate.toFixed(1) %>%</td>
                <td>
                  <% if (r.class_counts) { 
                       const keys = Object.keys(r.class_counts);
                       if (keys.length===0) { %>
                         <span class="muted">—</span>
                  <%   } else { %>
                         <% keys.forEach(k=>{ const v = r.class_counts[k]; const isDef = /defect/i.test(k); %>
                           <span class="badge <%= isDef ? 'defect' : 'ok' %>"><%= k %>: <%= v %></span>
                         <% }) %>
                  <%   } 
                     } else { %>
                    <span class="muted">—</span>
                  <% } %>
                </td>
                <td class="actions">
                  <% if (r.video_id) { %>
                    <a href="<%= r.video_id %>" target="_blank" rel="noopener">Video</a>
                  <% } else { %>
                    <span class="muted">No video</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    (function(){
      const $q = document.getElementById('q');
      const $from = document.getElementById('from');
      const $to = document.getElementById('to');
      const $sort = document.getElementById('sort');
      const $clear = document.getElementById('clear');
      const $export = document.getElementById('export');
      const $tbody = document.querySelector('#results-table tbody');
      const rows = Array.from($tbody.querySelectorAll('tr'));

      function inRange(d){
        if (!$from.value && !$to.value) return true;
        const ts = new Date(d).setHours(0,0,0,0);
        if ($from.value){
          const f = new Date($from.value).setHours(0,0,0,0);
          if (ts < f) return false;
        }
        if ($to.value){
          const t = new Date($to.value).setHours(23,59,59,999);
          if (new Date(d).getTime() > t) return false;
        }
        return true;
      }

      function apply(){
        const q = ($q.value||'').trim().toLowerCase();
        let visible = [];
        rows.forEach(tr=>{
          if (tr.querySelector('.empty')) return; // skip empty row
          const name = tr.getAttribute('data-name')||'';
          const created = tr.getAttribute('data-created');
          const rate = parseFloat(tr.getAttribute('data-defect-rate'))||0;
          const okName = !q || name.includes(q);
          const okDate = inRange(created);
          const show = okName && okDate;
          tr.style.display = show ? '' : 'none';
          if (show) visible.push({tr, created, rate});
        });
        // sort
        const mode = $sort.value;
        visible.sort((a,b)=>{
          switch(mode){
            case 'date_asc': return new Date(a.created) - new Date(b.created);
            case 'date_desc': return new Date(b.created) - new Date(a.created);
            case 'defect_asc': return a.rate - b.rate;
            case 'defect_desc': return b.rate - a.rate;
            default: return 0;
          }
        });
        // reattach in sorted order
        visible.forEach(({tr})=> $tbody.appendChild(tr));
        updateCards();
      }

      function updateCards(){
        let defect=0, total=0;
        Array.from($tbody.querySelectorAll('tr')).forEach(tr=>{
          if (tr.style.display==='none' || tr.querySelector('.empty')) return;
          const tds = tr.querySelectorAll('td');
          defect += parseInt(tds[2].textContent)||0;
          total += parseInt(tds[3].textContent)||0;
        });
        const rate = total>0 ? (defect/total*100) : 0;
        const card = document.querySelector('.cards .card');
        if (!card) return;
        const valEl = card.querySelector('.val');
        const rateEl = card.querySelector('.rate-badge');
        const totalEl = card.querySelector('.total-out-of');
        if (valEl) valEl.textContent = defect;
        if (totalEl) totalEl.textContent = total;
        if (rateEl) rateEl.textContent = rate.toFixed(1)+"%";
      }

      function toCSV(){
        const headers = Array.from(document.querySelectorAll('#results-table thead th')).map(th=>th.textContent.trim());
        const lines = [headers.join(',')];
        Array.from($tbody.querySelectorAll('tr')).forEach(tr=>{
          if (tr.style.display==='none' || tr.querySelector('.empty')) return;
          const cols = Array.from(tr.querySelectorAll('td')).map(td=>{
            const txt = td.textContent.trim().replaceAll('"', '""');
            return '"'+txt+'"';
          });
          lines.push(cols.join(','));
        });
        const blob = new Blob([lines.join('
')], {type:'text/csv'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = 'user_results.csv';
        document.body.appendChild(a); a.click(); a.remove();
        URL.revokeObjectURL(url);
      }

      $q.addEventListener('input', apply);
      $from.addEventListener('change', apply);
      $to.addEventListener('change', apply);
      $sort.addEventListener('change', apply);
      $clear.addEventListener('click', ()=>{ $q.value=''; $from.value=''; $to.value=''; $sort.value='date_desc'; apply(); });
      $export.addEventListener('click', toCSV);

      apply();
    })();
  </script>
</body>
</html>

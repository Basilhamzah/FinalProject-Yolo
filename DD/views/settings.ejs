<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Settings</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    /* لا يمس باقي الصفحات */
    .settings-page {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
      display: flex;
      min-height: 100vh;
      color: #fff;
    }

    .settings-sidebar {
      width: 220px;
      background-color: #1f1f2e;
      padding: 20px;
      position: fixed;
      inset: 0 auto 0 0;
    }
    .settings-sidebar h2 { font-size: 1.15rem; margin: 0 0 16px; }
    .settings-sidebar ul { list-style: none; margin: 0; padding: 0; }
    .settings-sidebar a {
      display: block; color: #fff; text-decoration: none;
      padding: 10px; border-radius: 8px; margin-bottom: 8px;
    }
    .settings-sidebar a:hover { background: #31314b; }

    .settings-main { margin-left: 240px; flex: 1; padding: 28px; }
    .settings-container { max-width: 780px; margin: 0 auto; display: grid; gap: 22px; }
    .settings-title { font-size: 26px; margin: 0 0 8px; font-weight: 700; }
    .settings-divider { height: 2px; background:#3bb1ff; opacity:.6; border-radius:2px; margin-bottom: 12px; }

    .settings-card {
      background: rgba(255,255,255,.06);
      border-radius: 14px;
      padding: 18px;
      box-shadow: 0 6px 18px rgba(154, 32, 161, 0.15);
    }
    .settings-card h3 {
      margin: 0 0 14px;
      font-size: 18px;
      color: #61dafb;
      display: flex; align-items: center; gap: 8px;
    }

    /* صف واحد أنيق: عناصر أصغر ومصطفة */
    .settings-row {
      display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
    }
    .settings-row .control { display: flex; flex-direction: column; gap: 6px; }
    .settings-label { font-size: 12px; opacity: .9; }

    .settings-input, .settings-select {
      width: 260px; max-width: 100%;
      padding: 9px 10px;
      border-radius: 10px;
      border: 1px solid rgba(223, 15, 15, 0.18);
      background: rgba(18, 79, 120, 0.186);
      color: #c2621e;
      outline: none;
    }
    .settings-input::placeholder { color: rgba(255,255,255,.8); }

    .settings-actions { display: flex; gap: 10px; margin-top: 6px; }
    .btn {
      background: linear-gradient(90deg, #00c6ff, #0072ff);
      border: none; color: #fff;
      padding: 9px 14px; border-radius: 10px;
      cursor: pointer; font-weight: 700; height: 38px;
    }
    .btn.secondary { background: #475569; }
    .btn:hover { opacity: .92; }

    @media (max-width: 900px){
      .settings-main { margin-left: 0; padding: 18px; }
      .settings-sidebar { position: static; width: 100%; border-bottom: 1px solid rgba(255,255,255,.1); }
      .settings-row { flex-direction: column; align-items: stretch; }
      .settings-input, .settings-select { width: 100%; }
      .settings-actions { flex-wrap: wrap; }
    }
  </style>
</head>
<body class="settings-page">
  <!-- Sidebar -->
  <aside class="settings-sidebar">
    <h2>👑 Admin: <%= username %></h2>
    <ul>
      <li><a href="/admin/dashboard">👥 Users Overview</a></li>
      <li><a href="/admin/results">📦 All Results</a></li> <!-- رابط صفحة النتائج -->
      <li><a href="/admin/settings">⚙️ Settings</a></li>
      <li><a href="/logout">🚪 Logout</a></li>
    </ul>
  </aside>

  <!-- Main -->
  <main class="settings-main">
    <div class="settings-container">
      <h1 class="settings-title">⚙️ Admin Settings</h1>

      <!-- 🔁 Change User Role -->
      <section class="settings-card">
        <h3>🔁 Change User Role</h3>
        <form action="/admin/change-role" method="POST">
          <div class="settings-row">
            <div class="control">
              <label class="settings-label">Select user</label>
              <select name="username" required class="settings-select">
                <% users.forEach(user => { %>
                  <option value="<%= user.username %>">
                    <%= user.username %> (Current: <%= user.role %>)
                  </option>
                <% }) %>
              </select>
            </div>

            <div class="control">
              <label class="settings-label">New role</label>
              <select name="role" required class="settings-select">
                <option value="user">User</option>
                <option value="admin">Admin</option>
              </select>
            </div>

            <div class="settings-actions">
              <button type="submit" class="btn">Update Role</button>
            </div>
          </div>
        </form>
      </section>

      <!-- 🔑 Change User Password -->
      <section class="settings-card">
        <h3>🔑 Change User Password</h3>
        <form action="/admin/change-user-password" method="POST">
          <div class="settings-row">
            <div class="control">
              <label class="settings-label">Select user</label>
              <select name="username" required class="settings-select">
                <% users.forEach(user => { %>
                  <option value="<%= user.username %>"><%= user.username %></option>
                <% }) %>
              </select>
            </div>

            <div class="control">
              <label class="settings-label">New password</label>
              <input type="password" name="newPassword" class="settings-input" placeholder="New Password" required>
            </div>

            <div class="settings-actions">
              <button type="submit" class="btn">Change Password</button>
            </div>
          </div>
        </form>
      </section>

      <!-- 🗑️ Delete User -->
      <section class="settings-card">
        <h3>🗑️ Delete User</h3>
        <form action="/admin/delete-user" method="POST" onsubmit="return confirm('Are you sure you want to delete this user?');">
          <div class="settings-row">
            <div class="control">
              <label class="settings-label">Select user</label>
              <select name="username" required class="settings-select">
                <% users.forEach(user => { %>
                  <option value="<%= user.username %>"><%= user.username %></option>
                <% }) %>
              </select>
            </div>

            <div class="settings-actions">
              <button type="submit" class="btn secondary">Delete User</button>
            </div>
          </div>
        </form>
      </section>
    </div>
  </main>
</body>
</html>
